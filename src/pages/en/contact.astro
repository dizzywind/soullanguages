---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
---

<BaseLayout title="Contact | Soul Languages" locale="en" switchPath="/contact/">
  <section class="hero">
    <div class="container prose">
      <h1 class="hero-mark" lang="zh-Hant">聯絡我們</h1>
      <p class="hero-sub">Contact</p>
      <p>Please reach out through our Google Form.</p>
      <hr class="hero-rule" />
      <a class="button" href={site.contactUrl} target="_blank" rel="noopener">
        Open Contact Form
      </a>
    </div>
  </section>
</BaseLayout>
