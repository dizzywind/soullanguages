---
import { episodes, type Locale } from '../data/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const playLabel = locale === 'zh' ? '播放' : 'Play';
---

<ul class="episode-grid">
  {
    episodes.map((ep) => (
      <li>
        <figure class="episode-card">
          <div class="video-frame">
            <img
              class="video-thumb"
              src={`${base}/images/ep/${ep.yt}.jpg`}
              alt=""
              width="1280"
              height="720"
              loading="lazy"
              decoding="async"
            />
            <button
              class="play-btn"
              type="button"
              data-yt={ep.yt}
              aria-label={`${playLabel}: ${ep.titles[locale]}`}
            >
              <svg viewBox="0 0 48 48" aria-hidden="true">
                <path d="M24 4a20 20 0 1 0 0 40 20 20 0 0 0 0-40Zm-6 12.5 15 7.5-15 7.5v-15Z" />
              </svg>
            </button>
          </div>
          <figcaption>
            <span class="ep-num">EP{ep.num}</span>{ep.titles[locale]}
          </figcaption>
        </figure>
      </li>
    ))
  }
</ul>
