---
import '@fontsource/eb-garamond/400.css';
import '@fontsource/eb-garamond/400-italic.css';
import '@fontsource/eb-garamond/600.css';
import '@fontsource/noto-serif-tc/400.css';
import '@fontsource/noto-serif-tc/500.css';
import '@fontsource/noto-serif-tc/600.css';
import '@fontsource/noto-serif-sc/400.css';
import '@fontsource/noto-serif-sc/500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, lp, type Locale } from '../data/site';

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  /** path of the current page without locale prefix, used for lang switch + hreflang */
  switchPath: string;
}

const { title, description, locale, switchPath } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, ''); // e.g. /soullanguages
const siteOrigin = Astro.site ?? new URL('https://dizzywind.github.io/');
const htmlLang = locale === 'zh' ? 'zh-Hant' : 'en';
const rel = switchPath.replace(/^\/?/, '/'); // /sutras/x/
const abs = (loc: Locale) =>
  new URL(`${base.slice(1)}/${loc === 'en' ? 'en' : ''}${rel}`.replace(/\/{2,}/g, '/'), siteOrigin).href;

const canonical = abs(locale);
const ogImage = new URL(`${base.slice(1)}/images/og-cover.jpg`, siteOrigin).href;
const otherLocale: Locale = locale === 'zh' ? 'en' : 'zh';
const altUrl = abs(otherLocale);

const siteDescription =
  description ??
  (locale === 'zh'
    ? '靈語是自然流露，不需要刻意學習 — 探索靈語的奧秘、靈修的力量，以及靈界的世界。'
    : 'Soul languages flow naturally — exploring the mystery of soul languages, spiritual practice, and the spiritual realm.');
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={siteDescription} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={htmlLang} href={canonical} />
    <link rel="alternate" hreflang={otherLocale === 'zh' ? 'zh-Hant' : 'en'} href={altUrl} />
    <link rel="alternate" hreflang="x-default" href={locale === 'zh' ? canonical : altUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header locale={locale} switchPath={switchPath} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <script src="../scripts/app.ts"></script>
  </body>
</html>
